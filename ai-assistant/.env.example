# Copy to .env and fill in.

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ASSISTANT_MODEL=claude-sonnet-5-5

# Gmail: path to the OAuth client file downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json

# Outlook / Microsoft 365: an Entra ID (Azure AD) app registration
# with "Allow public client flows" turned on.
MS_CLIENT_ID=
# "common" for personal + work accounts, or your tenant ID
MS_TENANT=common
MS_TOKEN_CACHE=secrets/ms_token_cache.json

# Which integrations to turn on (comma-separated).
# notes (Apple Notes) and imessage only work on a Mac; they're skipped on Windows.
ENABLED_TOOLS=gmail,outlook,linkedin,tasks

# Where the assistant keeps its tasks, approvals and run log
DATA_DIR=data

# How many hours back each scheduled run should look
LOOKBACK_HOURS=24

# Show macOS notifications when something needs your approval
NOTIFY=true
